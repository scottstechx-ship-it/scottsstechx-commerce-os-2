<?xml version="1.0" encoding="utf-8"?>
<!--
  ScottsTechX Commerce OS — Android client.
  Permissions:
    - INTERNET                (API client over HTTPS / Cloudflare tunnel)
    - ACCESS_NETWORK_STATE    (offline banner)
    - ACCESS_FINE_LOCATION    (buyer GPS for nearby sellers)
    - ACCESS_COARSE_LOCATION  (Android 12+ approximate-location fallback)
    - POST_NOTIFICATIONS      (Android 13+ runtime opt-in for order/match alerts)
  No CAMERA / STORAGE permissions; the photo proof-of-delivery upload
  uses the system file picker which does not require runtime grants.
  Network security config restricts cleartext to:
    - 10.0.2.2 (Android emulator host alias)
    - 127.0.0.1 / localhost (loopback)
    - 172.31.3.59 (laptop LAN IP for real-device testing on WiFi)
    - 192.168.173.1 / 192.168.5.1 / 192.168.137.1 (MyPublicWiFi hotspot adapter IPs)
  so the dev build doesn't accidentally talk plaintext to the public internet.
  v0.21.0: removed `usesCleartextTraffic="true"` (the network-security-config
  already enforces this more strictly per-domain).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location: used by the buyer to find nearby sellers and by the
         seller to publish their store location. FusedLocationProvider
         returns BestForNavigation accuracy (~30m). Coarse is the
         Android-12+ fallback when the user denies "fine" but grants
         "approximate". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- v0.21.0: Android 13+ requires runtime opt-in for notification
         posting. We declare it here so the app can call
         androidx.activity.compose.rememberLauncherForActivityResult
         with RequestPermission() at the right moment during onboarding. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ScottsTechXApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScottsTechX"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScottsTechX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
