<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed for:
    - 10.0.2.2 (Android emulator host alias)
    - 127.0.0.1 / localhost (loopback for local testing)
    - 172.31.3.59 (laptop LAN IP for real-device testing on WiFi)
    - 192.168.173.1 / 192.168.5.1 / 192.168.137.1 (MyPublicWiFi hotspot adapter IPs)
  Production traffic must always be HTTPS. Update this list when you
  change networks.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">172.31.3.59</domain>
        <domain includeSubdomains="false">192.168.173.1</domain>
        <domain includeSubdomains="false">192.168.5.1</domain>
        <domain includeSubdomains="false">192.168.137.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>