<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground. Composes the ScottsTechX company
  logo (from mipmap-nodpi/ic_launcher_legacy.png) centered in the
  108dp safe-area viewport. The launcher masks the outer ring; only
  the inner ~66dp is fully visible. We pad inward by ~14dp on each
  side so the logo doesn't get cropped.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_legacy" />
</layer-list>
