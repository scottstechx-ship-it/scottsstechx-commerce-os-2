    <!-- Accessibility -->
    <string name="accessibility_login_help_title">About signing in</string>
    <string name="accessibility_login_help_body">You can sign in with your phone and a password. If you have a Google account, the Continue with Google button is faster. After you pick a role — Buyer, Seller, or Driver — the right home screen opens for you.</string>
    <string name="accessibility_buyer_help_title">About this screen</string>
    <string name="accessibility_buyer_help_body">You are on the products page. Tap any product to add it to your cart. The little arrow icon finds sellers near you. The chat bubble opens the AI shopping helper. Sign out is at the right.</string>
    <string name="accessibility_seller_help_title">About your shop</string>
    <string name="accessibility_seller_help_body">You are on the seller dashboard. The big card on top shows your sales today. The Inventory tab lists your products and lets you add, edit, or remove them. The Orders tab lists incoming customer orders. The sparkles icon opens the AI assistant.</string>
    <string name="accessibility_continue_with_google">Continue with Google</string>
