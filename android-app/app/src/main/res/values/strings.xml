    <string name="accessibility_login_help_title">About signing in</string>
    <string name="accessibility_login_help_body">You can sign in with your phone and a password. If you have a Google account, the Continue with Google button will let you sign in with one tap. The button is faster. After you pick a role — Buyer, Seller, or Driver — the right home screen opens for you.</string>
