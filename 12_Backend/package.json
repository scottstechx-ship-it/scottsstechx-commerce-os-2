{
  "name": "scottstechx-commerce-os-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ScottsTechX Uganda MVP modular monolith backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "npm run build && node scripts/prod-boot-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:boot",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "vitest": "^3.2.7"
  }
}
