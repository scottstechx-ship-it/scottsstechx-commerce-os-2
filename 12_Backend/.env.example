# ScottsTechX backend — required env.
# Copy to .env and fill in real values. Never commit the real .env.

# --- Required ---
# JWT signing secret. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-48-byte-random-string-please-please-please

# Postgres connection string. For Supabase:
#   postgres://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# For self-hosted Postgres + embedded-postgres (dev only):
#   postgres://app:***@127.0.0.1:5433/scottstechx
DATABASE_URL=postgres://app:***@127.0.0.1:5433/scottstechx

# --- Optional: AI provider (set to enable AI features) ---
# AI_PROVIDER is one of: openai | anthropic | gemini
# Without LLM_API_KEY, AI endpoints return 503 ai_disabled.
AI_PROVIDER=openai
LLM_API_KEY=
# Model to use. Defaults are sensible per provider.
# OpenAI: gpt-4o-mini | Anthropic: claude-3-5-sonnet-latest | Gemini: gemini-1.5-flash
AI_MODEL=

# --- Optional: Google OAuth (set to enable "Continue with Google" on Android) ---
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
#   Create OAuth 2.0 Client ID -> Web application
# Copy the Client ID here. The Android client uses it as ServerClientId for
# Credential Manager's Google Identity One-Tap flow.
GOOGLE_CLIENT_ID=

# --- Optional: CORS allow-list (comma-separated origins) ---
# Used by the optional web admin client. Mobile apps ignore this.
# In development, all origins are allowed unless this is set explicitly.
ALLOWED_ORIGINS=https://admin.scottstechx.example,https://app.scottstechx.example

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
