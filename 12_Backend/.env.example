# ScottsTechX backend — required env.
# Copy to .env and fill in real values. Never commit the real .env.

# --- Required ---
# JWT signing secret. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-48-byte-random-string-please-please-please

# Postgres connection string. For Supabase:
#   postgres://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# For self-hosted Postgres + embedded-postgres (dev only):
#   postgres://app:***@127.0.0.1:5433/scottstechx
DATABASE_URL=postgres://app:***@127.0.0.1:5433/scottstechx

# --- Optional: AI provider (set to enable AI features) ---
# AI_PROVIDER is one of: openai | anthropic | gemini | openrouter | groq | apifreellm
# If AI_PROVIDER is unset and LLM_API_KEY is set, the default is "groq"
# (best free-tier latency: ~500ms p50 with llama-3.1-8b-instant).
# Without LLM_API_KEY, AI endpoints return 503 ai_disabled.
AI_PROVIDER=groq
LLM_API_KEY=
# Model to use. Defaults are sensible per provider.
# OpenAI: gpt-4o-mini | Anthropic: claude-3-5-sonnet-latest | Gemini: gemini-2.5-flash
# OpenRouter: openrouter/auto | Groq: llama-3.1-8b-instant | apifreellm: apifreellm
AI_MODEL=

# --- Optional: Provider fallback chain ---
# Set AI_CHAIN=fallback to enable automatic fallback when the primary provider
# fails. The chain walks: [primary] -> [apifreellm, free LLaMA] -> [deterministic mock].
# Requires LLM_API_KEY_FALLBACK to be set, otherwise the fallback step is skipped.
# AI_CHAIN=primary  (default — single provider, mock only when no keys at all)
# AI_CHAIN=fallback (chain through apifreellm on primary failure)
AI_CHAIN=primary
LLM_API_KEY_FALLBACK=
# Model override for the apifreellm fallback. Default: "apifreellm".
AI_MODEL_FALLBACK=apifreellm

# --- Optional: Google OAuth (set to enable "Continue with Google" on Android) ---
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
#   Create OAuth 2.0 Client ID -> Web application
# Copy the Client ID here. The Android client uses it as ServerClientId for
# Credential Manager's Google Identity One-Tap flow.
GOOGLE_CLIENT_ID=

# --- Optional: CORS allow-list (comma-separated origins) ---
# Used by the optional web admin client. Mobile apps ignore this.
# In development, all origins are allowed unless this is set explicitly.
ALLOWED_ORIGINS=https://admin.scottstechx.example,https://app.scottstechx.example

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- Optional: Firebase Admin SDK (for backend Firestore/Storage) ---
# Path to the service account JSON file (NEVER commit). Created at
# secrets/firebase-admin-key.json when you set up the project. Defaults
# to that path if unset.
# FIREBASE_ADMIN_KEY_PATH=secrets/firebase-admin-key.json
#
# If unset, the backend falls back gracefully: routes that need
# Firebase return 503 firebase_not_configured.

# --- Optional: Vertex AI / Gemini (alternative to OpenAI/Groq) ---
# Set AI_PROVIDER=gemini and LLM_API_KEY=<your Gemini API key> to use
# the Vertex AI Gemini API. Free tier: https://aistudio.google.com/
# AI_MODEL=gemini-2.5-flash  (default if unset)
